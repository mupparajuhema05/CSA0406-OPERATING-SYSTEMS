#include <stdio.h>
#include <string.h>
int main() {
    char dir[5][20], file[5][20], name[20];
    int n, i;
    printf("Enter number of users: ");
    scanf("%d", &n);
    printf("Enter directory and file names:\n");
    for(i = 0; i < n; i++)
        scanf("%s %s", dir[i], file[i]);
    printf("Enter file to search: ");
    scanf("%s", name);
    for(i = 0; i < n; i++) {
        if(strcmp(file[i], name) == 0) {
            printf("Directory: %s\nFile found: %s\n", dir[i], file[i]);
            return 0;
        }
    }
    printf("File not found\n");
    return 0;
}
