#include <stdio.h>

int main() {
    int p[20], f[10], t[10], n, m, i, j, k, pos, faults = 0, time = 0, hit;

    printf("Enter number of pages: ");
    scanf("%d", &n);

    printf("Enter page reference string: ");
    for (i = 0; i < n; i++)
        scanf("%d", &p[i]);

    printf("Enter number of frames: ");
    scanf("%d", &m);

    for (i = 0; i < m; i++)
        f[i] = -1, t[i] = 0;

    for (i = 0; i < n; i++) {
        hit = 0;
        time++;

        for (j = 0; j < m; j++)
            if (f[j] == p[i]) {
                t[j] = time;
                hit = 1;
            }

        if (!hit) {
            pos = 0;
            for (j = 1; j < m; j++)
                if (t[j] < t[pos])
                    pos = j;

            f[pos] = p[i];
            t[pos] = time;
            faults++;
        }

        for (k = 0; k < m; k++)
            printf("%d ", f[k]);
        printf("\n");
    }

    printf("Page Faults = %d\n", faults);
    return 0;
}
