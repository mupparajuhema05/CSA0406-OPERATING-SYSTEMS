#include <stdio.h>
int main() {
    int block[20], n, i;
    printf("Enter number of blocks: ");
    scanf("%d", &n)
    printf("Enter block numbers: ");
    for (i = 0; i < n; i++)
        scanf("%d", &block[i]);
    printf("Linked Allocation:\n");
    printf("First Block = %d\n", block[0]);
    printf("Last Block = %d\n", block[n - 1]);
    for (i = 0; i < n - 1; i++)
        printf("%d -> %d\n", block[i], block[i + 1]);
    printf("%d -> NULL\n", block[n - 1]);
    return 0;
}
