#include <stdio.h>
int main() {
    int b[10], p[10], temp[10];
    int nb, np, i, j, ch, k;
    printf("Blocks: ");
    scanf("%d", &nb);
    for(i = 0; i < nb; i++) scanf("%d", &b[i]);
    printf("Processes: ");
    scanf("%d", &np);
    for(i = 0; i < np; i++) scanf("%d", &p[i]);
    for(i = 0; i < nb; i++) temp[i] = b[i];
    printf("1.First Fit 2.Best Fit 3.Worst Fit\n");
    scanf("%d", &ch);
    printf("\nProcess\tBlock\n");
    for(i = 0; i < np; i++) {
        k = -1;
        for(j = 0; j < nb; j++) {
            if(temp[j] >= p[i]) {
                if(ch == 1) { k = j; break; }
                if(ch == 2 && (k == -1 || temp[j] < temp[k])) k = j;
                if(ch == 3 && (k == -1 || temp[j] > temp[k])) k = j;
            }
        }
        if(k != -1) {
            printf("P%d\tB%d\n", i + 1, k + 1);
            temp[k] -= p[i];
        } else {
            printf("P%d\tNot Allocated\n", i + 1);
        }
    }

    return 0;
}
