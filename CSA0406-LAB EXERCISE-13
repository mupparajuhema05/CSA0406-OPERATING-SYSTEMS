#include <stdio.h>
int mutex = 1, full = 0, empty = 3, x = 0;
void wait(int *s) { (*s)--; }
void signal(int *s) { (*s)++; }
int main() {
    int ch;
    while (1) {
        printf("\n1. Produce\n2. Consume\n3. Exit\n");
        scanf("%d", &ch);
        switch (ch) {
        case 1:
            if (empty > 0) {
                wait(&empty);
                wait(&mutex);
                x++;
                printf("Produced Item %d\n", x);
                signal(&mutex);
                signal(&full);
            } else
                printf("Buffer Full!\n");
            break;
        case 2:
            if (full > 0) {
                wait(&full);
                wait(&mutex);
                printf("Consumed Item %d\n", x);
                x--;
                signal(&mutex);
                signal(&empty);
            } else
                printf("Buffer Empty!\n");
            break;
        case 3:
            return 0;
        }
    }
}
