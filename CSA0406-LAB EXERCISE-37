#include <stdio.h>
#include <stdlib.h
int main() {
    int a[20], n, head, i, seek = 0;
    printf("Enter number of requests: ");
    scanf("%d", &n);
    printf("Enter requests: ");
    for (i = 0; i < n; i++)
        scanf("%d", &a[i])
    printf("Enter initial head position: ");
    scanf("%d", &head);
    for (i = 0; i < n; i++) {
        seek += abs(head - a[i]);
        head = a[i];
    }
    printf("Total Head Movement = %d\n", seek);
    return 0;
}
