#include <stdio.h>
#include <dirent.h>

int main()
{
    DIR *d;
    struct dirent *p;

    d = opendir(".");

    if (d == NULL) {
        printf("Directory not found");
        return 1;
    }

    printf("Files and Directories:\n");

    while ((p = readdir(d)) != NULL)
        printf("%s\n", p->d_name);

    closedir(d);

    return 0;
}
