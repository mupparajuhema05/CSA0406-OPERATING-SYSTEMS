Q1.File Allocation – Contiguous, Linked, Indexed :
#include <stdio.h>
#define MAX 100
int main() {
    int d[MAX]={0},n,f,m,i,j,c=0;
    printf("Disk blocks: "); scanf("%d",&n);
    printf("File size: "); scanf("%d",&f);
    printf("1.Contiguous 2.Linked 3.Indexed: "); scanf("%d",&m);
    if(m==1) {
        for(i=0;i<=n-f;i++) {
            for(j=i;j<i+f && d[j]==0;j++);
            if(j==i+f) break;
        }
        if(i>n-f) printf("Contiguous allocation failed\n");
        else {
            printf("Blocks: ");
            for(j=i;j<i+f;j++) printf("%d ",j);
        }
    }
    else if(m==2) {
        printf("Blocks: ");
        for(i=0;i<n && c<f;i++)
            if(!d[i]) { d[i]=1; printf("%d ",i); c++; }
        if(c<f) printf("\nAllocation failed");
    }
    else if(m==3) {
        printf("Index block: 0\nBlocks: ");
        d[0]=1;
        for(i=1;i<n && c<f;i++)
            if(!d[i]) { d[i]=1; printf("%d ",i); c++; }
    }
    else printf("Invalid method");
    return 0;
}
OUTPUT:
Disk blocks: 10
File size: 4
1.Contiguous 2.Linked 3.Indexed: 1
Blocks: 0 1 2 3

Q2.Bitmap Allocation :
