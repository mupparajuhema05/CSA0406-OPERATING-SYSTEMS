Q4.C-SCAN and LOOK :  
#include <stdio.h>
#include <stdlib.h>
int main() {
    int a[20],n,h,i,j,t,temp,total=0;
    printf("Requests: ");scanf("%d",&n);
    printf("Queue: ");
    for(i=0;i<n;i++)scanf("%d",&a[i]);
    printf("Head: ");scanf("%d",&h);
    for(i=0;i<n-1;i++)
        for(j=i+1;j<n;j++)
            if(a[i]>a[j]) {
                temp=a[i];a[i]=a[j];a[j]=temp;
            }
    printf("LOOK: %d",h);
    for(i=0;i<n;i++)
        if(a[i]>=h){total+=abs(h-a[i]);h=a[i];printf(" %d",h);}
    for(i=n-1;i>=0;i--)
        if(a[i]<h){total+=abs(h-a[i]);h=a[i];printf(" %d",h);}

    printf("\nLOOK Seek=%d\n",total);
    return 0;
}
OUTPUT:
Requests: 5
Queue: 98 183 37 122 14
Head: 53
LOOK: 53 98 122 183 37 14
LOOK Seek=299

