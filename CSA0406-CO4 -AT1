Q3.FCFS, SSTF, SCAN :
#include <stdio.h>
#include <stdlib.h>
#define MAX 50
void fcfs(int a[],int n,int h) {
    int i,t=0;
    printf("FCFS: %d",h);
    for(i=0;i<n;i++){t+=abs(h-a[i]);h=a[i];printf(" %d",h);}
    printf("\nSeek=%d\n",t);
}
void sstf(int a[],int n,int h) {
    int v[MAX]={0},i,j,k,d,min,t=0;
    printf("SSTF: %d",h);
    for(i=0;i<n;i++){
        min=9999;k=-1;
        for(j=0;j<n;j++)
            if(!v[j] && abs(h-a[j])<min)
                min=abs(h-a[j]),k=j;
        v[k]=1;t+=min;h=a[k];printf(" %d",h);
    }
    printf("\nSeek=%d\n",t);
}
int main() {
    int a[MAX],n,h,i;
    printf("Requests: ");scanf("%d",&n);
    printf("Queue: ");
    for(i=0;i<n;i++)scanf("%d",&a[i]);
    printf("Head: ");scanf("%d",&h);
    fcfs(a,n,h);
    sstf(a,n,h);
    return 0;
}
