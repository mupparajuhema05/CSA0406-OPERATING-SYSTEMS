#include <stdio.h>
#include <string.h>
int main() {
    char files[10][20], name[20];
    int n, i;
    printf("Enter number of files: ");
    scanf("%d", &n);
    printf("Enter file names:\n");
    for(i = 0; i < n; i++)
        scanf("%s", files[i]);
    printf("Enter file to search: ");
    scanf("%s", name);
    for(i = 0; i < n; i++) {
        if(strcmp(files[i], name) == 0) {
            printf("File found: %s\n", name);
            return 0;
        }
    }
    printf("File not found\n");
    return 0;
}
