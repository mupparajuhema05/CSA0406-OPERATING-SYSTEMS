#include <stdio.h>
#include <string.h>
struct UserDir {
    char name[10];
    char files[5][10];
    int fc;
} dir[5];
int main() {
    int dc = 0, ch, i, j;
    char uname[10], fname[10];
while (1) {
        printf("\n1. Create User  2. Create File  3. Delete File  4. Search File  5. Display  6. Exit\nChoice: ");
        scanf("%d", &ch);
if (ch == 1) {
            printf("Enter Username: ");
            scanf("%s", dir[dc].name);
            dir[dc++].fc = 0;
        } else if (ch == 2) {
            printf("Enter Username & File: ");
            scanf("%s %s", uname, fname);
            for (i = 0; i < dc; i++) {
                if (strcmp(uname, dir[i].name) == 0) {
                    strcpy(dir[i].files[dir[i].fc++], fname);
                    printf("File created.\n");
                    break;
                }
            }
            if (i == dc) printf("User not found!\n");
        } else if (ch == 3) {
            printf("Enter Username & File to Delete: ");
            scanf("%s %s", uname, fname);
            for (i = 0; i < dc; i++) {
                if (strcmp(uname, dir[i].name) == 0) {
                    for (j = 0; j < dir[i].fc; j++) {
                        if (strcmp(fname, dir[i].files[j]) == 0) {
                            strcpy(dir[i].files[j], dir[i].files[--dir[i].fc]);
                            printf("File deleted.\n");
                            break;
                        }
                    }
                    if (j == dir[i].fc) printf("File not found!\n");
                    break;
                }
            }
            if (i == dc) printf("User not found!\n");
        } else if (ch == 4) {
            printf("Enter File to Search: ");
            scanf("%s", fname);
            int found = 0;
            for (i = 0; i < dc; i++) {
                for (j = 0; j < dir[i].fc; j++) {
                    if (strcmp(fname, dir[i].files[j]) == 0) {
                        printf("Found under User '%s' at index %d\n", dir[i].name, j + 1);
                        found = 1;
                    }
                }
            }
            if (!found) printf("File not found anywhere!\n");
        } else if (ch == 5) {
            for (i = 0; i < dc; i++) {
                printf("\nUser: %s\nFiles: ", dir[i].name);
                for (j = 0; j < dir[i].fc; j++) printf("%s ", dir[i].files[j]);
                printf("\n");
            }
        } else break;
    }
    return 0;
}
