#include <stdio.h>
#include <string.h>
int main() {
    char dir[10], files[10][10], fname[10];
    int count = 0, ch, i;
printf("Enter directory name: ");
    scanf("%s", dir);
while (1) {
        printf("\n1. Create File  2. Delete File  3. Search File  4. Display  5. Exit\nEnter choice: ");
        scanf("%d", &ch);
if (ch == 1) {
            printf("Enter file name: ");
            scanf("%s", fname);
            for (i = 0; i < count; i++) {
                if (strcmp(fname, files[i]) == 0) {
                    printf("File already exists!\n");
                    break;
                }
            }
            if (i == count) strcpy(files[count++], fname);
        } else if (ch == 2) {
            printf("Enter file to delete: ");
            scanf("%s", fname);
            for (i = 0; i < count; i++) {
                if (strcmp(fname, files[i]) == 0) {
                    strcpy(files[i], files[--count]);
                    printf("File deleted.\n");
                    break;
                }
            }
            if (i == count) printf("File not found!\n");
        } else if (ch == 3) {
            printf("Enter file to search: ");
            scanf("%s", fname);
            for (i = 0; i < count; i++) {
                if (strcmp(fname, files[i]) == 0) {
                    printf("File found at position %d\n", i + 1);
                    break;
                }
            }
            if (i == count) printf("File not found!\n");
        } else if (ch == 4) {
            printf("\nDirectory: %s\nFiles: ", dir);
            for (i = 0; i < count; i++) printf("%s ", files[i]);
            printf("\n");
        } else break;
    }
    return 0;
}
