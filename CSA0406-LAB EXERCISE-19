#include <stdio.h>
int main() {
    int b[] = {100, 500, 200, 300, 600}, p[] = {212, 417, 112, 426};
    int nb = 5, np = 4, alloc[4];
for (int i = 0; i < np; i++) {
        alloc[i] = -1;
        for (int j = 0; j < nb; j++) {
            if (b[j] >= p[i]) {
                alloc[i] = j;
                b[j] -= p[i];
                break; // Select the first available block and stop searching
            }
        }
    }
printf("Process\tSize\tBlock\n");
    for (int i = 0; i < np; i++) {
        if (alloc[i] != -1)
            printf("  P%d\t%d\t  B%d\n", i + 1, p[i], alloc[i] + 1);
        else
            printf("  P%d\t%d\tNot Allocated\n", i + 1, p[i]);
    }
    return 0;
}
